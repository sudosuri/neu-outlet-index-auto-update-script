# Neu Appliance — filter index auto-update config
#
# LOCAL runs:  copy this file to ".env" (same folder) and paste your real values. ".env" is gitignored.
# GitHub Actions:  set these as repository SECRETS instead (Settings > Secrets and variables > Actions).
#                  Never commit real token values.

NEU_SHOPIFY_STORE=neu-appliances-2021.myshopify.com
NEU_SHOPIFY_API_VERSION=2025-01

# Admin API access token — the token MUST have both:  read_products  AND  write_themes
NEU_SHOPIFY_ACCESS_TOKEN=paste_your_admin_token_here_or_set_in_env

# DO NOT set NEU_THEME_ID. The deploy target is resolved LIVE from the Admin API (the role=main theme),
# so a theme republish needs no config change. A NEU_THEME_ID that disagrees with the live theme is now
# treated as an ERROR and aborts the deploy — it caused the Aug 2026 frozen-index outage, where a value
# left over inside an old Vercel deployment pinned the index to a retired theme for 5 days.
# For a deliberate one-off (e.g. seeding a dev theme) set NEU_THEME_ID_OVERRIDE instead, and unset it after.
# NOTE: on Vercel, deleting an env var only takes effect on the NEXT deployment — redeploy after changing it.
